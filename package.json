{
  "name": "mcodex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-releases.ps1 all",
    "release:source": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-releases.ps1 source",
    "release:portable": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-releases.ps1 portable",
    "release:sea": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-releases.ps1 sea",
    "start": "node dist/server/index.js",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "playwright-core": "^1.54.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
