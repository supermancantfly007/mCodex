# mCodex does NOT load .env automatically. Copy the values you need and set them
# as environment variables before starting (see README "Configuration").
# For LAN/direct mode use a strong 24+ character token.
# If BRIDGE_TOKEN is blank in external mode, Bridge persists a generated device-trust token.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3210
# Set this to true when a reverse proxy or SSH tunnel reaches a loopback-only Bridge.
# It enables pairing and token authentication without exposing the listener to the LAN.
BRIDGE_EXTERNAL_ACCESS=false
BRIDGE_TOKEN=
BRIDGE_TOKEN_FILE=
# Windows example: C:\Users\you\.codex
# macOS example: /Users/you/.codex
CODEX_HOME=
CODEX_CDP_URL=http://localhost:9222
