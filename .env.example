# mCodex does NOT load .env automatically. Copy the values you need and set them
# as environment variables before starting (see README "Configuration").
# For LAN/Tailscale direct mode use a strong 24+ character token.
# If BRIDGE_TOKEN is blank in external mode, Bridge persists a generated device-trust token.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3210
BRIDGE_TOKEN=
BRIDGE_TOKEN_FILE=
CODEX_HOME=C:\Users\you\.codex
CODEX_CDP_URL=http://localhost:9222