import AppKit
import Foundation

private struct PairingInfo: Decodable {
    let available: Bool
    let expiresAt: Double
    let pairingCode: String
}

private struct ManagerError: LocalizedError {
    let message: String
    var errorDescription: String? { message }
}

@MainActor
private final class AppDelegate: NSObject, NSApplicationDelegate, NSWindowDelegate {
    private let projectPath = "__MCODEX_PROJECT_ROOT__"
    private var window: NSWindow!
    private let statusLabel = NSTextField(labelWithString: "正在启动…")
    private let statusDetailLabel = NSTextField(wrappingLabelWithString: "正在启动原生 Bridge 与 VPS 隧道")
    private let pairingCodeLabel = NSTextField(labelWithString: "--------")
    private let countdownLabel = NSTextField(labelWithString: "正在获取配对码…")
    private let messageLabel = NSTextField(wrappingLabelWithString: "")
    private let openButton = NSButton(title: "打开网页", target: nil, action: nil)
    private let refreshButton = NSButton(title: "刷新配对码", target: nil, action: nil)
    private let quitButton = NSButton(title: "停止并退出", target: nil, action: nil)
    private var timer: Timer?
    private var pairingExpiresAt: Date?
    private var fetchingPairing = false
    private var ensuringServices = false
    private var lastEnsureAt = Date.distantPast
    private var lastPairingFetchAt = Date.distantPast
    private var terminationPending = false
    private var allowTermination = false

    func applicationDidFinishLaunching(_ notification: Notification) {
        buildApplicationMenu()
        buildWindow()
        setControlsEnabled(false)
        window.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
        startServices()
        timer = Timer.scheduledTimer(withTimeInterval: 1, repeats: true) { [weak self] _ in
            Task { @MainActor in self?.tick() }
        }
    }

    func applicationShouldHandleReopen(_ sender: NSApplication, hasVisibleWindows flag: Bool) -> Bool {
        window.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
        return true
    }

    func windowShouldClose(_ sender: NSWindow) -> Bool {
        NSApp.terminate(nil)
        return false
    }

    func applicationShouldTerminate(_ sender: NSApplication) -> NSApplication.TerminateReply {
        if allowTermination { return .terminateNow }
        if terminationPending { return .terminateLater }
        terminationPending = true
        setControlsEnabled(false)
        statusLabel.stringValue = "正在停止…"
        statusDetailLabel.stringValue = "正在停止 Bridge 与 VPS 隧道，Codex Desktop 会保持运行"
        runManager("down") { [weak self] result in
            guard let self else { return }
            self.allowTermination = true
            if case .failure(let error) = result {
                self.messageLabel.textColor = .systemRed
                self.messageLabel.stringValue = "停止时发生错误：\(error.localizedDescription)"
            }
            NSApp.reply(toApplicationShouldTerminate: true)
        }
        return .terminateLater
    }

    private func buildApplicationMenu() {
        let mainMenu = NSMenu()
        let appMenuItem = NSMenuItem()
        mainMenu.addItem(appMenuItem)
        let appMenu = NSMenu()
        appMenu.addItem(withTitle: "关于 mCodex Control", action: #selector(NSApplication.orderFrontStandardAboutPanel(_:)), keyEquivalent: "")
        appMenu.addItem(.separator())
        let quitItem = NSMenuItem(title: "停止并退出 mCodex Control", action: #selector(NSApplication.terminate(_:)), keyEquivalent: "q")
        appMenu.addItem(quitItem)
        appMenuItem.submenu = appMenu
        NSApp.mainMenu = mainMenu
    }

    private func buildWindow() {
        window = NSWindow(
            contentRect: NSRect(x: 0, y: 0, width: 540, height: 430),
            styleMask: [.titled, .closable, .miniaturizable],
            backing: .buffered,
            defer: false
        )
        window.title = "mCodex Control"
        window.center()
        window.isReleasedWhenClosed = false
        window.delegate = self
        window.backgroundColor = NSColor.windowBackgroundColor

        let titleLabel = NSTextField(labelWithString: "mCodex Control")
        titleLabel.font = .systemFont(ofSize: 26, weight: .bold)

        statusLabel.font = .systemFont(ofSize: 15, weight: .semibold)
        statusLabel.textColor = .secondaryLabelColor
        statusDetailLabel.font = .systemFont(ofSize: 12)
        statusDetailLabel.textColor = .secondaryLabelColor

        let codeCaption = NSTextField(labelWithString: "手机配对码")
        codeCaption.font = .systemFont(ofSize: 13, weight: .medium)
        codeCaption.textColor = .secondaryLabelColor
        pairingCodeLabel.font = .monospacedSystemFont(ofSize: 42, weight: .semibold)
        pairingCodeLabel.alignment = .center
        pairingCodeLabel.maximumNumberOfLines = 1
        countdownLabel.font = .monospacedDigitSystemFont(ofSize: 13, weight: .regular)
        countdownLabel.alignment = .center
        countdownLabel.textColor = .secondaryLabelColor

        let codeBox = NSBox()
        codeBox.boxType = .custom
        codeBox.cornerRadius = 12
        codeBox.borderWidth = 1
        codeBox.borderColor = NSColor.separatorColor
        codeBox.fillColor = NSColor.controlBackgroundColor
        codeBox.contentViewMargins = NSSize(width: 20, height: 18)
        let codeStack = NSStackView(views: [codeCaption, pairingCodeLabel, countdownLabel])
        codeStack.orientation = .vertical
        codeStack.alignment = .centerX
        codeStack.spacing = 8
        codeBox.contentView = codeStack

        messageLabel.font = .systemFont(ofSize: 12)
        messageLabel.textColor = .secondaryLabelColor
        messageLabel.alignment = .center
        messageLabel.maximumNumberOfLines = 2
        messageLabel.stringValue = "在手机网页输入配对码。关闭窗口或按 ⌘Q 会停止服务。"

        openButton.target = self
        openButton.action = #selector(openWeb)
        openButton.bezelStyle = .rounded
        openButton.keyEquivalent = "\r"
        refreshButton.target = self
        refreshButton.action = #selector(refreshPairing)
        refreshButton.bezelStyle = .rounded
        quitButton.target = self
        quitButton.action = #selector(stopAndQuit)
        quitButton.bezelStyle = .rounded

        let buttonStack = NSStackView(views: [quitButton, refreshButton, openButton])
        buttonStack.orientation = .horizontal
        buttonStack.alignment = .centerY
        buttonStack.distribution = .fillEqually
        buttonStack.spacing = 10

        let rootStack = NSStackView(views: [titleLabel, statusLabel, statusDetailLabel, codeBox, messageLabel, buttonStack])
        rootStack.orientation = .vertical
        rootStack.alignment = .leading
        rootStack.spacing = 10
        rootStack.setCustomSpacing(3, after: statusLabel)
        rootStack.setCustomSpacing(22, after: statusDetailLabel)
        rootStack.setCustomSpacing(18, after: codeBox)
        rootStack.translatesAutoresizingMaskIntoConstraints = false
        codeBox.translatesAutoresizingMaskIntoConstraints = false
        messageLabel.translatesAutoresizingMaskIntoConstraints = false
        buttonStack.translatesAutoresizingMaskIntoConstraints = false

        guard let contentView = window.contentView else { return }
        contentView.addSubview(rootStack)
        NSLayoutConstraint.activate([
            rootStack.leadingAnchor.constraint(equalTo: contentView.leadingAnchor, constant: 30),
            rootStack.trailingAnchor.constraint(equalTo: contentView.trailingAnchor, constant: -30),
            rootStack.topAnchor.constraint(equalTo: contentView.topAnchor, constant: 26),
            rootStack.bottomAnchor.constraint(lessThanOrEqualTo: contentView.bottomAnchor, constant: -24),
            codeBox.widthAnchor.constraint(equalTo: rootStack.widthAnchor),
            codeBox.heightAnchor.constraint(equalToConstant: 150),
            messageLabel.widthAnchor.constraint(equalTo: rootStack.widthAnchor),
            buttonStack.widthAnchor.constraint(equalTo: rootStack.widthAnchor),
            buttonStack.heightAnchor.constraint(equalToConstant: 34),
        ])
    }

    private func startServices() {
        ensuringServices = true
        lastEnsureAt = Date()
        statusLabel.stringValue = "正在启动…"
        runManager("up") { [weak self] result in
            guard let self else { return }
            self.ensuringServices = false
            self.lastEnsureAt = Date()
            switch result {
            case .success:
                self.statusLabel.textColor = .systemGreen
                self.statusLabel.stringValue = "● mCodex 正在运行"
                self.statusDetailLabel.stringValue = "原生 Bridge 与 VPS 隧道均由本 App 管理，不使用 Docker"
                self.messageLabel.textColor = .secondaryLabelColor
                self.messageLabel.stringValue = "在手机网页输入配对码。关闭窗口或按 ⌘Q 会停止服务。"
                self.setControlsEnabled(true)
                self.fetchPairing(refresh: false)
            case .failure(let error):
                self.statusLabel.textColor = .systemRed
                self.statusLabel.stringValue = "● 启动失败"
                self.statusDetailLabel.stringValue = error.localizedDescription
                self.messageLabel.textColor = .systemRed
                self.messageLabel.stringValue = "可以查看项目日志后重试，或停止并退出。"
                self.quitButton.isEnabled = true
            }
        }
    }

    private func tick() {
        guard !terminationPending else { return }
        updateCountdown()
        let now = Date()
        if now.timeIntervalSince(lastEnsureAt) >= 15, !ensuringServices {
            ensuringServices = true
            lastEnsureAt = now
            runManager("ensure") { [weak self] result in
                guard let self else { return }
                self.ensuringServices = false
                if case .failure(let error) = result {
                    self.statusLabel.textColor = .systemOrange
                    self.statusLabel.stringValue = "● 正在恢复连接"
                    self.statusDetailLabel.stringValue = error.localizedDescription
                } else {
                    self.statusLabel.textColor = .systemGreen
                    self.statusLabel.stringValue = "● mCodex 正在运行"
                    self.statusDetailLabel.stringValue = "原生 Bridge 与 VPS 隧道均由本 App 管理，不使用 Docker"
                }
            }
        }

        if (pairingExpiresAt == nil || pairingExpiresAt! <= now), now.timeIntervalSince(lastPairingFetchAt) >= 3 {
            fetchPairing(refresh: false)
        }
    }

    private func updateCountdown() {
        guard let expiry = pairingExpiresAt else { return }
        let seconds = max(0, Int(expiry.timeIntervalSinceNow.rounded(.up)))
        let minutesPart = seconds / 60
        let secondsPart = seconds % 60
        countdownLabel.stringValue = String(format: "有效期剩余 %02d:%02d · 到期后自动刷新", minutesPart, secondsPart)
    }

    private func fetchPairing(refresh: Bool) {
        guard !fetchingPairing else { return }
        fetchingPairing = true
        lastPairingFetchAt = Date()
        refreshButton.isEnabled = false
        runManager(refresh ? "refresh-pairing" : "pairing-info") { [weak self] result in
            guard let self else { return }
            self.fetchingPairing = false
            self.refreshButton.isEnabled = !self.terminationPending
            switch result {
            case .success(let output):
                do {
                    let info = try JSONDecoder().decode(PairingInfo.self, from: Data(output.utf8))
                    self.pairingCodeLabel.stringValue = info.available && !info.pairingCode.isEmpty ? info.pairingCode : "未启用"
                    self.pairingExpiresAt = Date(timeIntervalSince1970: info.expiresAt / 1000)
                    self.updateCountdown()
                } catch {
                    self.showPairingError("无法解析配对码信息")
                }
            case .failure(let error):
                self.showPairingError(error.localizedDescription)
            }
        }
    }

    private func showPairingError(_ message: String) {
        pairingCodeLabel.stringValue = "--------"
        countdownLabel.stringValue = "配对码暂不可用，正在自动重试"
        messageLabel.textColor = .systemOrange
        messageLabel.stringValue = message
        pairingExpiresAt = nil
    }

    private func setControlsEnabled(_ enabled: Bool) {
        openButton.isEnabled = enabled
        refreshButton.isEnabled = enabled
        quitButton.isEnabled = enabled
    }

    @objc private func openWeb() {
        runManager("open") { [weak self] result in
            if case .failure(let error) = result {
                self?.messageLabel.textColor = .systemRed
                self?.messageLabel.stringValue = error.localizedDescription
            }
        }
    }

    @objc private func refreshPairing() {
        fetchPairing(refresh: true)
    }

    @objc private func stopAndQuit() {
        NSApp.terminate(nil)
    }

    private func runManager(_ command: String, completion: @escaping (Result<String, Error>) -> Void) {
        let managerPath = URL(fileURLWithPath: projectPath).appendingPathComponent("scripts/manage-native-macos.sh").path
        DispatchQueue.global(qos: .userInitiated).async {
            let process = Process()
            let pipe = Pipe()
            process.executableURL = URL(fileURLWithPath: "/bin/zsh")
            process.arguments = [managerPath, command]
            process.currentDirectoryURL = URL(fileURLWithPath: self.projectPath)
            var environment = ProcessInfo.processInfo.environment
            environment["PATH"] = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
            process.environment = environment
            process.standardOutput = pipe
            process.standardError = pipe
            do {
                try process.run()
                let data = pipe.fileHandleForReading.readDataToEndOfFile()
                process.waitUntilExit()
                let output = String(data: data, encoding: .utf8)?.trimmingCharacters(in: .whitespacesAndNewlines) ?? ""
                DispatchQueue.main.async {
                    if process.terminationStatus == 0 {
                        completion(.success(output))
                    } else {
                        completion(.failure(ManagerError(message: output.isEmpty ? "控制命令执行失败" : output)))
                    }
                }
            } catch {
                DispatchQueue.main.async { completion(.failure(error)) }
            }
        }
    }
}

@main
private struct MCodexControlApp {
    static func main() {
        let application = NSApplication.shared
        let delegate = AppDelegate()
        application.delegate = delegate
        application.setActivationPolicy(.regular)
        application.run()
    }
}
