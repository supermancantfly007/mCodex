# Public HTTPS entry for an mCodex Bridge reached through an SSH reverse tunnel.
# Replace the site name and upstream. If Caddy runs in Docker, use the host-side
# address that is reachable from its Docker network rather than 127.0.0.1.
mcodex.example.com {
	encode zstd gzip

	# Optional second layer in addition to Cloudflare Access. Generate the hash
	# with `caddy hash-password` and keep the real credential outside the repo.
	# basic_auth {
	# 	admin <CADDY_PASSWORD_HASH>
	# }

	# The pairing code must only be read from the Mac page or local logs. A
	# reverse tunnel otherwise makes the proxy request appear local to mCodex.
	@local_pairing_info path /api/pairing-info /api/pairing-refresh
	respond @local_pairing_info 404

	request_body {
		max_size 64MB
	}

	header {
		Cache-Control "no-store"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}

	# When Caddy runs in Docker, point this at a systemd socket proxy bound only
	# to the Caddy network's host gateway, for example 172.19.0.1:13211.
	reverse_proxy 127.0.0.1:13210 {
		transport http {
			dial_timeout 5s
			read_timeout 360s
		}
	}

	# mCodex currently uses the device token in WebSocket and media URLs.
	# Discard access logs so those query strings are never written to disk.
	log {
		output discard
	}
}
